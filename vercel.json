{
  "rewrites": [
    {
      "source": "/api/staff/session",
      "destination": "/api/staff/login"
    },
    {
      "source": "/api/device/:subpath*",
      "destination": "/api/device"
    },
    {
      "source": "/api/admin/devices/:subpath*",
      "destination": "/api/admin/staff"
    },
    {
      "source": "/api/admin/devices",
      "destination": "/api/admin/staff"
    },
    {
      "source": "/api/admin/session",
      "destination": "/api/admin/session"
    },
    {
      "source": "/api/admin/logout",
      "destination": "/api/admin/logout"
    },
    {
      "source": "/api/admin/db-diagnostic",
      "destination": "/api/admin/staff"
    },
    {
      "source": "/api/admin/staff/:subpath+",
      "destination": "/api/admin/staff"
    },
    {
      "source": "/api/admin/face-requests/:subpath+",
      "destination": "/api/admin/face-requests"
    },
    {
      "source": "/api/staff/face/:subpath+",
      "destination": "/api/staff/face"
    }
  ]
}
