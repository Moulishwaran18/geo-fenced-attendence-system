# PostgreSQL Database Connection String for CampusAttend
# Replace with your PostgreSQL connection URL (e.g., Supabase, Neon, Railway, or local PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/campus_biometrics

# Alternatively, set individual PostgreSQL connection parameters:
# PGHOST=localhost
# PGPORT=5432
# PGUSER=postgres
# PGPASSWORD=postgres
# PGDATABASE=campus_biometrics
